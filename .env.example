# PostgreSQL connection used by Next.js and maintenance scripts.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/db_herdsync"

# Public application origin used for CSRF validation behind a reverse proxy or tunnel.
APP_ORIGIN="https://herdsync.example.com"

# Required only while running `npm run create-admin`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
ADMIN_NAME="HerdSync Administrator"
